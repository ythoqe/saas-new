rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string
        && emailKey.size() >= 3
        && emailKey.size() <= 254
        && emailKey.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // RBAC & Invite-Only Allowlist Helpers (Verified from Firestore /allowed_users/{email} & /users/{uid})
    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'hmmojjammalhoq@gmail.com';
    }

    function hasAllowedUserDoc() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower()));
    }

    function isAllowedUser() {
      return isBootstrappedAdmin() || hasAllowedUserDoc();
    }

    function getAllowedUserRole() {
      return get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())).data.role;
    }

    function hasUserProfile() {
      return isAllowedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAllowedUser()
        && (
          isBootstrappedAdmin()
          || (hasAllowedUserDoc() && getAllowedUserRole() == 'admin')
          || (hasUserProfile() && getUserRole() == 'admin')
        );
    }

    function isManager() {
      return isAllowedUser()
        && (
          (hasUserProfile() && getUserRole() == 'manager')
          || (hasAllowedUserDoc() && getAllowedUserRole() == 'manager')
        );
    }

    function isAccountant() {
      return isAllowedUser()
        && (
          (hasUserProfile() && getUserRole() == 'accountant')
          || (hasAllowedUserDoc() && getAllowedUserRole() == 'accountant')
        );
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function isAdminOrAccountant() {
      return isAdmin() || isAccountant();
    }

    function isMillStaff() {
      return isAdmin() || isManager() || isAccountant();
    }

    function isPositiveBoundedNumber(val, maxVal) {
      return (val is int || val is float) && val > 0 && val <= maxVal;
    }

    function isNonNegativeBoundedNumber(val, maxVal) {
      return (val is int || val is float) && val >= 0 && val <= maxVal;
    }

    function isValidLedgerAmount(val) {
      return (val is int || val is float) && val >= 0 && val <= 1000000000;
    }

    function isValidExpenseCategory(category) {
      return category is string
        && category.size() >= 1
        && category.size() <= 30
        && category in [
          'Salary',
          'Electricity',
          'Rent',
          'Transport',
          'Maintenance',
          'Food',
          'Office',
          'Other'
        ];
    }

    // Validation Blueprint: UserProfile entity
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.role is string
        && data.role.size() >= 5
        && data.role.size() <= 10
        && data.role in ['admin', 'manager', 'accountant']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: RbacBootstrap singleton
    function isValidBootstrapMeta(data) {
      return data.keys().hasAll([
          'firstAdminUid',
          'initializedAt'
        ])
        && data.keys().hasOnly([
          'firstAdminUid',
          'initializedAt'
        ])
        && isValidId(data.firstAdminUid)
        && data.initializedAt is timestamp;
    }

    // Validation Blueprint: AllowedUser entity (Invite-Only Email Allowlist)
    function isValidAllowedUser(data) {
      return data.keys().hasAll([
          'email',
          'role',
          'invitedByUid',
          'invitedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'email',
          'role',
          'invitedByUid',
          'invitedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && isValidEmailKey(data.email)
        && data.role is string
        && data.role.size() >= 5
        && data.role.size() <= 10
        && data.role in ['admin', 'manager', 'accountant']
        && isValidId(data.invitedByUid)
        && data.invitedByEmail is string
        && data.invitedByEmail.size() >= 3
        && data.invitedByEmail.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: Client entity
    function isValidClient(data) {
      return data.keys().hasAll([
          'ownerId',
          'clientName',
          'companyName',
          'mobile',
          'address',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'clientName',
          'companyName',
          'mobile',
          'address',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.clientName is string
        && data.clientName.size() >= 1
        && data.clientName.size() <= 120
        && data.companyName is string
        && data.companyName.size() >= 1
        && data.companyName.size() <= 160
        && data.mobile is string
        && data.mobile.size() >= 5
        && data.mobile.size() <= 25
        && data.mobile.matches('^[+0-9 ()-]+$')
        && data.address is string
        && data.address.size() >= 1
        && data.address.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ClientLedgerEntry entity (Debit increases due, Credit decreases due)
    function isValidLedgerEntry(data) {
      return data.keys().hasAll([
          'ownerId',
          'clientId',
          'txn_type',
          'debit',
          'credit',
          'note',
          'reference',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'clientId',
          'txn_type',
          'debit',
          'credit',
          'note',
          'reference',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.clientId)
        && data.txn_type is string
        && data.txn_type.size() >= 1
        && data.txn_type.size() <= 20
        && data.txn_type in ['opening', 'invoice', 'payment', 'adjustment']
        && isValidLedgerAmount(data.debit)
        && isValidLedgerAmount(data.credit)
        && ((data.debit > 0 && data.credit == 0) || (data.credit > 0 && data.debit == 0))
        && (data.txn_type != 'opening' || (data.debit > 0 && data.credit == 0))
        && (data.txn_type != 'invoice' || (data.debit > 0 && data.credit == 0))
        && (data.txn_type != 'payment' || (data.credit > 0 && data.debit == 0))
        && data.note is string
        && data.note.size() <= 300
        && data.reference is string
        && data.reference.size() <= 80
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: Order entity
    function isValidOrder(data) {
      return data.keys().hasAll([
          'ownerId',
          'clientId',
          'orderDate',
          'fabricType',
          'greyFabricThan',
          'greyFabricGaj',
          'rate',
          'status',
          'finalGaj',
          'finalBillAmount',
          'deliveredAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'clientId',
          'orderDate',
          'fabricType',
          'greyFabricThan',
          'greyFabricGaj',
          'rate',
          'status',
          'finalGaj',
          'finalBillAmount',
          'deliveredAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.clientId)
        && data.orderDate is string
        && data.orderDate.size() == 10
        && data.orderDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.fabricType is string
        && data.fabricType.size() >= 1
        && data.fabricType.size() <= 40
        && data.fabricType in ['মার্কিন', 'লংক্লথ', 'ভয়েল', 'পপলিন', 'ইউনিটিকা', 'আস্তর']
        && isPositiveBoundedNumber(data.greyFabricThan, 1000000)
        && isPositiveBoundedNumber(data.greyFabricGaj, 10000000)
        && isPositiveBoundedNumber(data.rate, 1000000)
        && data.status is string
        && data.status.size() >= 1
        && data.status.size() <= 30
        && data.status in ['Processing', 'Dyeing', 'Washing', 'Finishing', 'Delivered']
        && (
          (
            data.status != 'Delivered'
            && data.finalGaj == null
            && data.finalBillAmount == null
            && data.deliveredAt == null
          ) || (
            data.status == 'Delivered'
            && isPositiveBoundedNumber(data.finalGaj, 10000000)
            && isPositiveBoundedNumber(data.finalBillAmount, 1000000000)
            && data.deliveredAt is timestamp
          )
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: MoneyInRecord entity (Client Receipt)
    function isValidMoneyIn(data) {
      return data.keys().hasAll([
          'ownerId',
          'clientId',
          'ledgerEntryId',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'clientId',
          'ledgerEntryId',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.clientId)
        && isValidId(data.ledgerEntryId)
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^PAY-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 30
        && data.paymentMethod in ['Cash', 'Bank', 'Mobile Banking']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: MoneyInRecord (Append-Only Cash Reversal Adjustment)
    function isValidAdjustmentMoneyIn(data) {
      return data.keys().hasAll([
          'ownerId',
          'source',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'source',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.source is string
        && data.source.size() == 10
        && data.source == 'adjustment'
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^REV-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 30
        && data.paymentMethod in ['Cash', 'Bank', 'Mobile Banking']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: MoneyInRecord (Atomic Account-to-Account Transfer Inflow)
    function isValidTransferMoneyIn(data) {
      return data.keys().hasAll([
          'ownerId',
          'source',
          'category',
          'transferId',
          'counterAccount',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'source',
          'category',
          'transferId',
          'counterAccount',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.source is string
        && data.source.size() == 8
        && data.source == 'transfer'
        && data.category is string
        && data.category.size() == 8
        && data.category == 'Transfer'
        && data.transferId is string
        && data.transferId.size() >= 5
        && data.transferId.size() <= 80
        && data.transferId.matches('^TRF-[a-zA-Z0-9_\\-]+$')
        && data.counterAccount is string
        && data.counterAccount.size() >= 1
        && data.counterAccount.size() <= 30
        && data.counterAccount in ['Cash', 'Bank', 'Mobile Banking']
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^TRF-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 30
        && data.paymentMethod in ['Cash', 'Bank', 'Mobile Banking']
        && data.paymentMethod != data.counterAccount
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: Supplier entity (strictly excludes stored balance/payable fields)
    function isValidSupplier(data) {
      return data.keys().hasAll([
          'ownerId',
          'supplierName',
          'companyName',
          'mobile',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'supplierName',
          'companyName',
          'mobile',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.supplierName is string
        && data.supplierName.size() >= 1
        && data.supplierName.size() <= 120
        && data.companyName is string
        && data.companyName.size() >= 1
        && data.companyName.size() <= 160
        && data.mobile is string
        && data.mobile.size() >= 5
        && data.mobile.size() <= 25
        && data.mobile.matches('^[+0-9 ()-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: SupplierLedgerEntry entity (Inverted payable logic: Credit = we owe, Debit = we paid)
    function isValidSupplierLedgerEntry(data) {
      return data.keys().hasAll([
          'ownerId',
          'supplierId',
          'txn_type',
          'debit',
          'credit',
          'reference',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'supplierId',
          'txn_type',
          'debit',
          'credit',
          'reference',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.supplierId)
        && data.txn_type is string
        && data.txn_type.size() >= 1
        && data.txn_type.size() <= 20
        && data.txn_type in ['opening', 'purchase', 'payment', 'adjustment']
        && isValidLedgerAmount(data.debit)
        && isValidLedgerAmount(data.credit)
        && ((data.debit > 0 && data.credit == 0) || (data.credit > 0 && data.debit == 0))
        && (data.txn_type != 'opening' || (data.credit > 0 && data.debit == 0))
        && (data.txn_type != 'purchase' || (data.credit > 0 && data.debit == 0))
        && (data.txn_type != 'payment' || (data.debit > 0 && data.credit == 0))
        && data.reference is string
        && data.reference.size() <= 80
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: Purchase entity (Supports optional status: Pending | Paid)
    function isValidPurchase(data) {
      return data.keys().hasAll([
          'ownerId',
          'supplierId',
          'ledgerEntryId',
          'reference',
          'purchaseDate',
          'itemName',
          'quantity',
          'unit',
          'rate',
          'totalAmount',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'supplierId',
          'ledgerEntryId',
          'reference',
          'purchaseDate',
          'itemName',
          'quantity',
          'unit',
          'rate',
          'totalAmount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.supplierId)
        && isValidId(data.ledgerEntryId)
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^PUR-[a-zA-Z0-9_\\-]+$')
        && data.purchaseDate is string
        && data.purchaseDate.size() == 10
        && data.purchaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.itemName is string
        && data.itemName.size() >= 1
        && data.itemName.size() <= 160
        && isPositiveBoundedNumber(data.quantity, 10000000)
        && data.unit is string
        && data.unit.size() >= 1
        && data.unit.size() <= 20
        && data.unit in ['KG', 'Liter', 'Pcs']
        && isPositiveBoundedNumber(data.rate, 10000000)
        && isPositiveBoundedNumber(data.totalAmount, 1000000000)
        && math.abs(data.totalAmount - (data.quantity * data.rate)) <= 0.02
        && (!('status' in data) || (data.status is string && data.status.size() >= 4 && data.status.size() <= 10 && data.status in ['Pending', 'Paid']))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Validation Blueprint: MoneyOutRecord (Supplier Payment Outflow)
    function isValidSupplierMoneyOut(data) {
      return data.keys().hasAll([
          'ownerId',
          'supplierId',
          'ledgerEntryId',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'supplierId',
          'ledgerEntryId',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.supplierId)
        && isValidId(data.ledgerEntryId)
        && data.reference is string
        && data.reference.size() >= 6
        && data.reference.size() <= 80
        && data.reference.matches('^SPAY-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 20
        && data.paymentMethod in ['Cash', 'Bank']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: MoneyOutRecord (Factory Expense Outflow)
    function isValidExpenseMoneyOut(data) {
      return data.keys().hasAll([
          'ownerId',
          'expenseId',
          'category',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'expenseId',
          'category',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.expenseId)
        && isValidExpenseCategory(data.category)
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^EXP-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 20
        && data.paymentMethod in ['Cash', 'Bank']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: MoneyOutRecord (Employee Weekly Advance Outflow)
    function isValidAdvanceMoneyOut(data) {
      return data.keys().hasAll([
          'ownerId',
          'employeeId',
          'advanceId',
          'category',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'employeeId',
          'advanceId',
          'category',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.employeeId)
        && isValidId(data.advanceId)
        && data.category is string
        && data.category.size() == 16
        && data.category == 'Employee Advance'
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^ADV-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 20
        && data.paymentMethod in ['Cash', 'Bank']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: MoneyOutRecord (Monthly Employee Salary Payment Outflow)
    function isValidSalaryMoneyOut(data) {
      return data.keys().hasAll([
          'ownerId',
          'employeeId',
          'salaryPaymentId',
          'category',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'employeeId',
          'salaryPaymentId',
          'category',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.employeeId)
        && isValidId(data.salaryPaymentId)
        && data.category is string
        && data.category.size() == 6
        && data.category == 'Salary'
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^SAL-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 20
        && data.paymentMethod in ['Cash', 'Bank']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: MoneyOutRecord (Append-Only Cash Reversal Adjustment)
    function isValidAdjustmentMoneyOut(data) {
      return data.keys().hasAll([
          'ownerId',
          'source',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'source',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.source is string
        && data.source.size() == 10
        && data.source == 'adjustment'
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^REV-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 30
        && data.paymentMethod in ['Cash', 'Bank', 'Mobile Banking']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: MoneyOutRecord (Atomic Account-to-Account Transfer Outflow)
    function isValidTransferMoneyOut(data) {
      return data.keys().hasAll([
          'ownerId',
          'source',
          'category',
          'transferId',
          'counterAccount',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'source',
          'category',
          'transferId',
          'counterAccount',
          'reference',
          'amount',
          'paymentDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.source is string
        && data.source.size() == 8
        && data.source == 'transfer'
        && data.category is string
        && data.category.size() == 8
        && data.category == 'Transfer'
        && data.transferId is string
        && data.transferId.size() >= 5
        && data.transferId.size() <= 80
        && data.transferId.matches('^TRF-[a-zA-Z0-9_\\-]+$')
        && data.counterAccount is string
        && data.counterAccount.size() >= 1
        && data.counterAccount.size() <= 30
        && data.counterAccount in ['Cash', 'Bank', 'Mobile Banking']
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^TRF-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 30
        && data.paymentMethod in ['Cash', 'Bank', 'Mobile Banking']
        && data.paymentMethod != data.counterAccount
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: Expense entity
    function isValidExpense(data) {
      return data.keys().hasAll([
          'ownerId',
          'moneyOutId',
          'reference',
          'expenseDate',
          'category',
          'amount',
          'paymentMethod',
          'description',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'moneyOutId',
          'reference',
          'expenseDate',
          'category',
          'amount',
          'paymentMethod',
          'description',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.moneyOutId)
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^EXP-[a-zA-Z0-9_\\-]+$')
        && data.expenseDate is string
        && data.expenseDate.size() == 10
        && data.expenseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidExpenseCategory(data.category)
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 20
        && data.paymentMethod in ['Cash', 'Bank']
        && data.description is string
        && data.description.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: InventoryItem entity
    function isValidInventoryItem(data) {
      return data.keys().hasAll([
          'ownerId',
          'itemName',
          'unit',
          'minStockLevel',
          'currentStock',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'itemName',
          'unit',
          'minStockLevel',
          'currentStock',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.itemName is string
        && data.itemName.size() >= 1
        && data.itemName.size() <= 120
        && data.unit is string
        && data.unit.size() >= 1
        && data.unit.size() <= 20
        && data.unit in ['KG', 'Liter', 'Pcs']
        && isNonNegativeBoundedNumber(data.minStockLevel, 10000000)
        && isNonNegativeBoundedNumber(data.currentStock, 10000000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: StockMovement entity
    function isValidStockMovement(data) {
      return data.keys().hasAll([
          'ownerId',
          'inventoryItemId',
          'itemName',
          'unit',
          'type',
          'quantity',
          'previousStock',
          'resultingStock',
          'movementDate',
          'reference',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'inventoryItemId',
          'itemName',
          'unit',
          'type',
          'quantity',
          'previousStock',
          'resultingStock',
          'movementDate',
          'reference',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.inventoryItemId)
        && data.itemName is string
        && data.itemName.size() >= 1
        && data.itemName.size() <= 120
        && data.unit is string
        && data.unit.size() >= 1
        && data.unit.size() <= 20
        && data.unit in ['KG', 'Liter', 'Pcs']
        && data.type is string
        && data.type.size() >= 1
        && data.type.size() <= 20
        && data.type in ['opening', 'in', 'out', 'purchase']
        && isPositiveBoundedNumber(data.quantity, 10000000)
        && isNonNegativeBoundedNumber(data.previousStock, 10000000)
        && isNonNegativeBoundedNumber(data.resultingStock, 10000000)
        && (data.type != 'opening' || (data.previousStock == 0 && math.abs(data.resultingStock - data.quantity) <= 0.02))
        && ((data.type != 'in' && data.type != 'purchase') || math.abs(data.resultingStock - (data.previousStock + data.quantity)) <= 0.02)
        && (data.type != 'out' || math.abs(data.resultingStock - (data.previousStock - data.quantity)) <= 0.02)
        && data.movementDate is string
        && data.movementDate.size() == 10
        && data.movementDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.reference is string
        && data.reference.size() <= 80
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: Employee entity
    function isValidEmployee(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'mobile',
          'department',
          'joiningDate',
          'basicSalary',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'mobile',
          'department',
          'joiningDate',
          'basicSalary',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.mobile is string
        && data.mobile.size() >= 5
        && data.mobile.size() <= 25
        && data.mobile.matches('^[+0-9 ()-]+$')
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 60
        && data.joiningDate is string
        && data.joiningDate.size() == 10
        && data.joiningDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isPositiveBoundedNumber(data.basicSalary, 100000000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: EmployeeAdvance entity
    function isValidEmployeeAdvance(data) {
      return data.keys().hasAll([
          'ownerId',
          'employeeId',
          'employeeName',
          'department',
          'moneyOutId',
          'reference',
          'amount',
          'advanceDate',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'employeeId',
          'employeeName',
          'department',
          'moneyOutId',
          'reference',
          'amount',
          'advanceDate',
          'paymentMethod',
          'note',
          'createdAt',
          'deducted',
          'deductedBySalaryId',
          'deductedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.employeeId)
        && data.employeeName is string
        && data.employeeName.size() >= 1
        && data.employeeName.size() <= 120
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 60
        && isValidId(data.moneyOutId)
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^ADV-[a-zA-Z0-9_\\-]+$')
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.advanceDate is string
        && data.advanceDate.size() == 10
        && data.advanceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 20
        && data.paymentMethod in ['Cash', 'Bank']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp
        && (!('deducted' in data) || data.deducted is bool)
        && (!('deductedBySalaryId' in data) || (
          data.deductedBySalaryId is string
          && data.deductedBySalaryId.size() >= 5
          && data.deductedBySalaryId.size() <= 80
          && data.deductedBySalaryId.matches('^SAL-[a-zA-Z0-9_\\-]+$')
        ))
        && (!('deductedAt' in data) || data.deductedAt is timestamp);
    }

    // Validation Blueprint: SalaryPayment entity
    function isValidSalaryPayment(data) {
      return data.keys().hasAll([
          'ownerId',
          'employeeId',
          'employeeName',
          'department',
          'moneyOutId',
          'reference',
          'salaryMonth',
          'paymentDate',
          'basicSalary',
          'overtimeAmount',
          'bonusAmount',
          'advanceDeduction',
          'netSalary',
          'deductedAdvanceCount',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'employeeId',
          'employeeName',
          'department',
          'moneyOutId',
          'reference',
          'salaryMonth',
          'paymentDate',
          'basicSalary',
          'overtimeAmount',
          'bonusAmount',
          'advanceDeduction',
          'netSalary',
          'deductedAdvanceCount',
          'paymentMethod',
          'note',
          'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.employeeId)
        && data.employeeName is string
        && data.employeeName.size() >= 1
        && data.employeeName.size() <= 120
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 60
        && data.moneyOutId is string
        && data.moneyOutId.size() <= 128
        && (data.moneyOutId == '' || isValidId(data.moneyOutId))
        && data.reference is string
        && data.reference.size() >= 5
        && data.reference.size() <= 80
        && data.reference.matches('^SAL-[a-zA-Z0-9_\\-]+$')
        && data.salaryMonth is string
        && data.salaryMonth.size() == 7
        && data.salaryMonth.matches('^[0-9]{4}-[0-9]{2}$')
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isPositiveBoundedNumber(data.basicSalary, 100000000)
        && isNonNegativeBoundedNumber(data.overtimeAmount, 100000000)
        && isNonNegativeBoundedNumber(data.bonusAmount, 100000000)
        && isNonNegativeBoundedNumber(data.advanceDeduction, 1000000000)
        && isNonNegativeBoundedNumber(data.netSalary, 1000000000)
        && math.abs(data.netSalary - (data.basicSalary + data.overtimeAmount + data.bonusAmount - data.advanceDeduction)) <= 0.02
        && data.deductedAdvanceCount is int
        && data.deductedAdvanceCount >= 0
        && data.deductedAdvanceCount <= 500
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 20
        && data.paymentMethod in ['Cash', 'Bank']
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: Cheque entity (State machine with atomic clearing)
    function isValidCheque(data) {
      return data.keys().hasAll([
          'ownerId',
          'clientId',
          'clientName',
          'amount',
          'bankName',
          'chequeNo',
          'chequeDate',
          'status',
          'endorsedSupplierId',
          'endorsedSupplierName',
          'endorsedDate',
          'clearedDate',
          'bouncedDate',
          'bounceReason',
          'moneyInId',
          'clientLedgerEntryId',
          'supplierLedgerEntryId',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'clientId',
          'clientName',
          'amount',
          'bankName',
          'chequeNo',
          'chequeDate',
          'status',
          'endorsedSupplierId',
          'endorsedSupplierName',
          'endorsedDate',
          'clearedDate',
          'bouncedDate',
          'bounceReason',
          'moneyInId',
          'clientLedgerEntryId',
          'supplierLedgerEntryId',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.clientId)
        && data.clientName is string
        && data.clientName.size() >= 1
        && data.clientName.size() <= 120
        && isPositiveBoundedNumber(data.amount, 1000000000)
        && data.bankName is string
        && data.bankName.size() >= 1
        && data.bankName.size() <= 120
        && data.chequeNo is string
        && data.chequeNo.size() >= 1
        && data.chequeNo.size() <= 80
        && data.chequeDate is string
        && data.chequeDate.size() == 10
        && data.chequeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status is string
        && data.status.size() >= 7
        && data.status.size() <= 30
        && data.status in [
          'Pending',
          'Endorsed to Supplier',
          'Cleared (Self)',
          'Cleared (Supplier)',
          'Bounced'
        ]
        && (data.endorsedSupplierId == null || isValidId(data.endorsedSupplierId))
        && (data.endorsedSupplierName == null || (data.endorsedSupplierName is string && data.endorsedSupplierName.size() >= 1 && data.endorsedSupplierName.size() <= 120))
        && (data.endorsedDate == null || (data.endorsedDate is string && data.endorsedDate.size() == 10 && data.endorsedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (data.clearedDate == null || (data.clearedDate is string && data.clearedDate.size() == 10 && data.clearedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (data.bouncedDate == null || (data.bouncedDate is string && data.bouncedDate.size() == 10 && data.bouncedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.bounceReason is string
        && data.bounceReason.size() <= 300
        && (data.moneyInId == null || isValidId(data.moneyInId))
        && (data.clientLedgerEntryId == null || isValidId(data.clientLedgerEntryId))
        && (data.supplierLedgerEntryId == null || isValidId(data.supplierLedgerEntryId))
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /app_meta/{metaId} (First-User Admin Bootstrap Sentinel)
    match /app_meta/{metaId} {
      allow get: if isVerifiedUser()
        && metaId == 'bootstrap';

      allow list: if false;

      allow create: if isVerifiedUser()
        && metaId == 'bootstrap'
        && isValidBootstrapMeta(incoming())
        && incoming().firstAdminUid == request.auth.uid
        && incoming().initializedAt == request.time
        && !exists(/databases/$(database)/documents/app_meta/bootstrap);

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /allowed_users/{emailKey} (Invite-Only Email Allowlist — Managed by Admin)
    match /allowed_users/{emailKey} {
      allow get: if isVerifiedUser()
        && isValidEmailKey(emailKey)
        && (
          (request.auth.token.email is string && request.auth.token.email.lower() == emailKey)
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidEmailKey(emailKey)
        && isValidAllowedUser(incoming())
        && incoming().email == emailKey
        && incoming().invitedByUid == request.auth.uid
        && incoming().invitedByEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            // First-user bootstrap auto-registers first admin into allowed_users
            request.auth.token.email is string
            && emailKey == request.auth.token.email.lower()
            && incoming().role == 'admin'
            && !exists(/databases/$(database)/documents/app_meta/bootstrap)
            && existsAfter(/databases/$(database)/documents/app_meta/bootstrap)
            && getAfter(/databases/$(database)/documents/app_meta/bootstrap).data.firstAdminUid == request.auth.uid
          )
        );

      allow update: if isVerifiedUser()
        && isValidEmailKey(emailKey)
        && isValidAllowedUser(incoming())
        && isAdmin()
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'role',
          'invitedByUid',
          'invitedByEmail',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidEmailKey(emailKey)
        && isAdmin()
        && emailKey != 'hmmojjammalhoq@gmail.com'
        && !(request.auth.token.email is string && emailKey == request.auth.token.email.lower());
    }

    // Collection: /users/{userId} (User Profiles & RBAC Roles — Restricted to Invited Users Only)
    match /users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && isAllowedUser()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            // Invited User: email exists in allowed_users and role matches assigned role
            hasAllowedUserDoc()
            && incoming().role == getAllowedUserRole()
          ) || (
            // First User Rule OR Runtime Bootstrapped Admin
            incoming().role == 'admin'
            && (
              isBootstrappedAdmin()
              || (
                !exists(/databases/$(database)/documents/app_meta/bootstrap)
                && existsAfter(/databases/$(database)/documents/app_meta/bootstrap)
                && getAfter(/databases/$(database)/documents/app_meta/bootstrap).data.firstAdminUid == request.auth.uid
              )
            )
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isAllowedUser()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Admin changes a user's RBAC role
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
          ) || (
            // Action 2: User refreshes their own displayName or syncs their role from allowed_users
            request.auth.uid == userId
            && (
              incoming().role == existing().role
              || (hasAllowedUserDoc() && incoming().role == getAllowedUserRole())
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // Collection: /clients/{clientId} (Read: All Mill Staff | Create: Admin/Manager | Edit/Delete: Admin ONLY)
    match /clients/{clientId} {
      allow get: if isVerifiedUser()
        && isValidId(clientId)
        && isMillStaff();

      allow list: if isMillStaff();

      allow create: if isVerifiedUser()
        && isValidId(clientId)
        && isValidClient(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdminOrManager();

      allow update: if isVerifiedUser()
        && isValidId(clientId)
        && isValidClient(incoming())
        && isAdmin()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'clientName',
          'companyName',
          'mobile',
          'address',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(clientId)
        && isAdmin();
    }

    // Collection: /client_ledger/{entryId} (Append-Only Client Transaction Log — Immutable)
    match /client_ledger/{entryId} {
      allow get: if isVerifiedUser()
        && isValidId(entryId)
        && isMillStaff();

      allow list: if isMillStaff();

      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidLedgerEntry(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (isManager() && incoming().txn_type in ['opening', 'invoice'])
          || (isAccountant() && incoming().txn_type in ['payment', 'adjustment', 'invoice'])
        )
        && (
          existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId))
          || (
            incoming().txn_type == 'adjustment'
            && !existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId))
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /orders/{orderId} (Admin & Manager ONLY | Edit Details & Delete: Admin ONLY while Processing)
    match /orders/{orderId} {
      allow get: if isVerifiedUser()
        && isValidId(orderId)
        && isAdminOrManager();

      allow list: if isAdminOrManager();

      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status != 'Delivered'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdminOrManager()
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId));

      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && existing().status != 'Delivered'
        && incoming().ownerId == existing().ownerId
        && incoming().clientId == existing().clientId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Admin or Manager updates production stage while in progress
          (
            isAdminOrManager()
            && incoming().status != 'Delivered'
            && incoming().orderDate == existing().orderDate
            && incoming().fabricType == existing().fabricType
            && incoming().greyFabricThan == existing().greyFabricThan
            && incoming().greyFabricGaj == existing().greyFabricGaj
            && incoming().rate == existing().rate
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            // Action 2: Admin ONLY edits order details while Processing
            isAdmin()
            && existing().status == 'Processing'
            && incoming().status == 'Processing'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'orderDate',
              'fabricType',
              'greyFabricThan',
              'greyFabricGaj',
              'rate',
              'updatedAt'
            ])
          ) || (
            // Action 3: Admin or Manager completes & delivers with atomic client_ledger invoice
            isAdminOrManager()
            && incoming().status == 'Delivered'
            && incoming().orderDate == existing().orderDate
            && incoming().fabricType == existing().fabricType
            && incoming().greyFabricThan == existing().greyFabricThan
            && incoming().greyFabricGaj == existing().greyFabricGaj
            && incoming().rate == existing().rate
            && incoming().deliveredAt == request.time
            && math.abs(incoming().finalBillAmount - (incoming().finalGaj * existing().rate)) <= 0.02
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'finalGaj',
              'finalBillAmount',
              'deliveredAt',
              'updatedAt'
            ])
            && existsAfter(/databases/$(database)/documents/client_ledger/$('INV_' + orderId))
            && getAfter(/databases/$(database)/documents/client_ledger/$('INV_' + orderId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/client_ledger/$('INV_' + orderId)).data.clientId == existing().clientId
            && getAfter(/databases/$(database)/documents/client_ledger/$('INV_' + orderId)).data.txn_type == 'invoice'
            && getAfter(/databases/$(database)/documents/client_ledger/$('INV_' + orderId)).data.debit == incoming().finalBillAmount
            && getAfter(/databases/$(database)/documents/client_ledger/$('INV_' + orderId)).data.credit == 0
            && getAfter(/databases/$(database)/documents/client_ledger/$('INV_' + orderId)).data.reference == orderId
          )
        );

      // Delete allowed ONLY by Admin while status is Processing (never once Delivered)
      allow delete: if isVerifiedUser()
        && isValidId(orderId)
        && existing().status == 'Processing'
        && isAdmin();
    }

    // Collection: /money_in/{paymentId} (Strictly Admin & Accountant ONLY — Append-Only Immutable)
    match /money_in/{paymentId} {
      allow get: if isVerifiedUser()
        && isValidId(paymentId)
        && isAdminOrAccountant();

      allow list: if isAdminOrAccountant();

      allow create: if isVerifiedUser()
        && isValidId(paymentId)
        && (
          (
            isValidMoneyIn(incoming())
            && incoming().ledgerEntryId == paymentId
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdminOrAccountant()
            && exists(/databases/$(database)/documents/clients/$(incoming().clientId))
            && existsAfter(/databases/$(database)/documents/client_ledger/$(paymentId))
            && getAfter(/databases/$(database)/documents/client_ledger/$(paymentId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/client_ledger/$(paymentId)).data.clientId == incoming().clientId
            && getAfter(/databases/$(database)/documents/client_ledger/$(paymentId)).data.txn_type == 'payment'
            && getAfter(/databases/$(database)/documents/client_ledger/$(paymentId)).data.debit == 0
            && getAfter(/databases/$(database)/documents/client_ledger/$(paymentId)).data.credit == incoming().amount
            && getAfter(/databases/$(database)/documents/client_ledger/$(paymentId)).data.reference == paymentId
          ) || (
            isValidAdjustmentMoneyIn(incoming())
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdminOrAccountant()
          ) || (
            isValidTransferMoneyIn(incoming())
            && incoming().transferId == paymentId
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdminOrAccountant()
            && existsAfter(/databases/$(database)/documents/money_out/$(paymentId))
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.source == 'transfer'
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.category == 'Transfer'
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.transferId == paymentId
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.reference == paymentId
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.amount == incoming().amount
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.paymentDate == incoming().paymentDate
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.paymentMethod == incoming().counterAccount
            && getAfter(/databases/$(database)/documents/money_out/$(paymentId)).data.counterAccount == incoming().paymentMethod
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /suppliers/{supplierId} (Read: All Mill Staff | Create: Admin/Manager | Edit/Delete: Admin ONLY)
    match /suppliers/{supplierId} {
      allow get: if isVerifiedUser()
        && isValidId(supplierId)
        && isMillStaff();

      allow list: if isMillStaff();

      allow create: if isVerifiedUser()
        && isValidId(supplierId)
        && isValidSupplier(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdminOrManager();

      allow update: if isVerifiedUser()
        && isValidId(supplierId)
        && isValidSupplier(incoming())
        && isAdmin()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'supplierName',
          'companyName',
          'mobile',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(supplierId)
        && isAdmin();
    }

    // Collection: /supplier_ledger/{entryId} (Append-Only Supplier Payable Log — Immutable)
    match /supplier_ledger/{entryId} {
      allow get: if isVerifiedUser()
        && isValidId(entryId)
        && isMillStaff();

      allow list: if isMillStaff();

      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidSupplierLedgerEntry(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (isManager() && incoming().txn_type in ['opening', 'purchase'])
          || (isAccountant() && incoming().txn_type in ['payment', 'adjustment'])
        )
        && (
          existsAfter(/databases/$(database)/documents/suppliers/$(incoming().supplierId))
          || (
            incoming().txn_type == 'adjustment'
            && !existsAfter(/databases/$(database)/documents/suppliers/$(incoming().supplierId))
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /purchases/{purchaseId} (Admin & Manager ONLY | Edit Details & Delete: Admin ONLY while Pending)
    match /purchases/{purchaseId} {
      allow get: if isVerifiedUser()
        && isValidId(purchaseId)
        && isAdminOrManager();

      allow list: if isAdminOrManager();

      allow create: if isVerifiedUser()
        && isValidId(purchaseId)
        && isValidPurchase(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().ledgerEntryId == purchaseId
        && incoming().reference == purchaseId
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        && isAdminOrManager()
        && exists(/databases/$(database)/documents/suppliers/$(incoming().supplierId))
        && existsAfter(/databases/$(database)/documents/supplier_ledger/$(purchaseId))
        && getAfter(/databases/$(database)/documents/supplier_ledger/$(purchaseId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/supplier_ledger/$(purchaseId)).data.supplierId == incoming().supplierId
        && getAfter(/databases/$(database)/documents/supplier_ledger/$(purchaseId)).data.txn_type == 'purchase'
        && getAfter(/databases/$(database)/documents/supplier_ledger/$(purchaseId)).data.credit == incoming().totalAmount
        && getAfter(/databases/$(database)/documents/supplier_ledger/$(purchaseId)).data.debit == 0
        && getAfter(/databases/$(database)/documents/supplier_ledger/$(purchaseId)).data.reference == purchaseId;

      allow update: if isVerifiedUser()
        && isValidId(purchaseId)
        && isValidPurchase(incoming())
        && (!('status' in existing()) || existing().status == 'Pending')
        && incoming().ownerId == existing().ownerId
        && incoming().supplierId == existing().supplierId
        && incoming().ledgerEntryId == existing().ledgerEntryId
        && incoming().reference == existing().reference
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Admin ONLY edits pending purchase details
          (
            isAdmin()
            && (!('status' in incoming()) || incoming().status == 'Pending')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'purchaseDate',
              'itemName',
              'quantity',
              'unit',
              'rate',
              'totalAmount',
              'status',
              'updatedAt'
            ])
          ) || (
            // Action 2: Admin or Manager marks pending purchase as Paid (terminal lock)
            isAdminOrManager()
            && incoming().status == 'Paid'
            && incoming().purchaseDate == existing().purchaseDate
            && incoming().itemName == existing().itemName
            && incoming().quantity == existing().quantity
            && incoming().unit == existing().unit
            && incoming().rate == existing().rate
            && incoming().totalAmount == existing().totalAmount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(purchaseId)
        && (!('status' in existing()) || existing().status == 'Pending')
        && isAdmin();
    }

    // Collection: /money_out/{paymentId} (Strictly Admin & Accountant ONLY — Append-Only Immutable)
    match /money_out/{paymentId} {
      allow get: if isVerifiedUser()
        && isValidId(paymentId)
        && isAdminOrAccountant();

      allow list: if isAdminOrAccountant();

      allow create: if isVerifiedUser()
        && isValidId(paymentId)
        && (
          (
            isValidSupplierMoneyOut(incoming())
            && incoming().ledgerEntryId == paymentId
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdminOrAccountant()
            && exists(/databases/$(database)/documents/suppliers/$(incoming().supplierId))
            && existsAfter(/databases/$(database)/documents/supplier_ledger/$(paymentId))
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(paymentId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(paymentId)).data.supplierId == incoming().supplierId
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(paymentId)).data.txn_type == 'payment'
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(paymentId)).data.debit == incoming().amount
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(paymentId)).data.credit == 0
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(paymentId)).data.reference == paymentId
          ) || (
            isValidExpenseMoneyOut(incoming())
            && incoming().expenseId == paymentId
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdminOrAccountant()
            && existsAfter(/databases/$(database)/documents/expenses/$(paymentId))
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.moneyOutId == paymentId
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.reference == paymentId
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.category == incoming().category
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.amount == incoming().amount
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.expenseDate == incoming().paymentDate
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.paymentMethod == incoming().paymentMethod
            && getAfter(/databases/$(database)/documents/expenses/$(paymentId)).data.description == incoming().note
          ) || (
            isValidAdvanceMoneyOut(incoming())
            && incoming().advanceId == paymentId
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdmin()
            && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
            && existsAfter(/databases/$(database)/documents/employee_advances/$(paymentId))
            && getAfter(/databases/$(database)/documents/employee_advances/$(paymentId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/employee_advances/$(paymentId)).data.employeeId == incoming().employeeId
            && getAfter(/databases/$(database)/documents/employee_advances/$(paymentId)).data.moneyOutId == paymentId
            && getAfter(/databases/$(database)/documents/employee_advances/$(paymentId)).data.reference == paymentId
            && getAfter(/databases/$(database)/documents/employee_advances/$(paymentId)).data.amount == incoming().amount
            && getAfter(/databases/$(database)/documents/employee_advances/$(paymentId)).data.advanceDate == incoming().paymentDate
            && getAfter(/databases/$(database)/documents/employee_advances/$(paymentId)).data.paymentMethod == incoming().paymentMethod
          ) || (
            isValidSalaryMoneyOut(incoming())
            && incoming().salaryPaymentId == paymentId
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdmin()
            && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
            && existsAfter(/databases/$(database)/documents/salary_payments/$(paymentId))
            && getAfter(/databases/$(database)/documents/salary_payments/$(paymentId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/salary_payments/$(paymentId)).data.employeeId == incoming().employeeId
            && getAfter(/databases/$(database)/documents/salary_payments/$(paymentId)).data.moneyOutId == paymentId
            && getAfter(/databases/$(database)/documents/salary_payments/$(paymentId)).data.reference == paymentId
            && getAfter(/databases/$(database)/documents/salary_payments/$(paymentId)).data.netSalary == incoming().amount
            && getAfter(/databases/$(database)/documents/salary_payments/$(paymentId)).data.paymentDate == incoming().paymentDate
            && getAfter(/databases/$(database)/documents/salary_payments/$(paymentId)).data.paymentMethod == incoming().paymentMethod
          ) || (
            isValidAdjustmentMoneyOut(incoming())
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdminOrAccountant()
          ) || (
            isValidTransferMoneyOut(incoming())
            && incoming().transferId == paymentId
            && incoming().reference == paymentId
            && incoming().createdAt == request.time
            && isAdminOrAccountant()
            && existsAfter(/databases/$(database)/documents/money_in/$(paymentId))
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.source == 'transfer'
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.category == 'Transfer'
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.transferId == paymentId
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.reference == paymentId
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.amount == incoming().amount
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.paymentDate == incoming().paymentDate
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.paymentMethod == incoming().counterAccount
            && getAfter(/databases/$(database)/documents/money_in/$(paymentId)).data.counterAccount == incoming().paymentMethod
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /expenses/{expenseId} (Strictly Admin & Accountant ONLY — Append-Only Immutable)
    match /expenses/{expenseId} {
      allow get: if isVerifiedUser()
        && isValidId(expenseId)
        && isAdminOrAccountant();

      allow list: if isAdminOrAccountant();

      allow create: if isVerifiedUser()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().moneyOutId == expenseId
        && incoming().reference == expenseId
        && incoming().createdAt == request.time
        && isAdminOrAccountant()
        && existsAfter(/databases/$(database)/documents/money_out/$(expenseId))
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.expenseId == expenseId
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.reference == expenseId
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.category == incoming().category
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.amount == incoming().amount
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.paymentDate == incoming().expenseDate
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.paymentMethod == incoming().paymentMethod
        && getAfter(/databases/$(database)/documents/money_out/$(expenseId)).data.note == incoming().description;

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /inventory/{itemId} (Admin & Manager | Master Edit & Delete: Admin ONLY)
    match /inventory/{itemId} {
      allow get: if isVerifiedUser()
        && isValidId(itemId)
        && isAdminOrManager();

      allow list: if isAdminOrManager();

      allow create: if isVerifiedUser()
        && isValidId(itemId)
        && isValidInventoryItem(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdminOrManager();

      allow update: if isVerifiedUser()
        && isValidId(itemId)
        && isValidInventoryItem(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Admin or Manager performs Stock In / Stock Out / Purchase auto-restock
          (
            isAdminOrManager()
            && incoming().itemName == existing().itemName
            && incoming().unit == existing().unit
            && incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
          ) || (
            // Action 2: Admin ONLY edits Master Data (name, unit, minimum stock alert level)
            isAdmin()
            && incoming().currentStock == existing().currentStock
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'itemName',
              'unit',
              'minStockLevel',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(itemId)
        && isAdmin();
    }

    // Collection: /stock_movements/{movementId} (Admin & Manager ONLY — Append-Only Immutable)
    match /stock_movements/{movementId} {
      allow get: if isVerifiedUser()
        && isValidId(movementId)
        && isAdminOrManager();

      allow list: if isAdminOrManager();

      allow create: if isVerifiedUser()
        && isValidId(movementId)
        && isValidStockMovement(incoming())
        && incoming().createdAt == request.time
        && isAdminOrManager()
        && existsAfter(/databases/$(database)/documents/inventory/$(incoming().inventoryItemId))
        && getAfter(/databases/$(database)/documents/inventory/$(incoming().inventoryItemId)).data.unit == incoming().unit
        && math.abs(getAfter(/databases/$(database)/documents/inventory/$(incoming().inventoryItemId)).data.currentStock - incoming().resultingStock) <= 0.02;

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /employees/{employeeId} (Strictly Admin ONLY)
    match /employees/{employeeId} {
      allow get: if isVerifiedUser()
        && isValidId(employeeId)
        && isAdmin();

      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(employeeId)
        && isValidEmployee(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerifiedUser()
        && isValidId(employeeId)
        && isValidEmployee(incoming())
        && isAdmin()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'mobile',
          'department',
          'joiningDate',
          'basicSalary',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(employeeId)
        && isAdmin();
    }

    // Collection: /employee_advances/{advanceId} (Strictly Admin ONLY — Immutable except one-way atomic salary deduction lock)
    match /employee_advances/{advanceId} {
      allow get: if isVerifiedUser()
        && isValidId(advanceId)
        && isAdmin();

      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(advanceId)
        && isValidEmployeeAdvance(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().moneyOutId == advanceId
        && incoming().reference == advanceId
        && incoming().createdAt == request.time
        && (!('deducted' in incoming()) || incoming().deducted == false)
        && !('deductedBySalaryId' in incoming())
        && !('deductedAt' in incoming())
        && isAdmin()
        && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
        && existsAfter(/databases/$(database)/documents/money_out/$(advanceId))
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.employeeId == incoming().employeeId
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.advanceId == advanceId
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.category == 'Employee Advance'
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.reference == advanceId
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.amount == incoming().amount
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.paymentDate == incoming().advanceDate
        && getAfter(/databases/$(database)/documents/money_out/$(advanceId)).data.paymentMethod == incoming().paymentMethod;

      allow update: if isVerifiedUser()
        && isValidId(advanceId)
        && isValidEmployeeAdvance(incoming())
        && isAdmin()
        && (!('deducted' in existing()) || existing().deducted == false)
        && incoming().ownerId == existing().ownerId
        && incoming().employeeId == existing().employeeId
        && incoming().employeeName == existing().employeeName
        && incoming().department == existing().department
        && incoming().moneyOutId == existing().moneyOutId
        && incoming().reference == existing().reference
        && incoming().amount == existing().amount
        && incoming().advanceDate == existing().advanceDate
        && incoming().paymentMethod == existing().paymentMethod
        && incoming().note == existing().note
        && incoming().createdAt == existing().createdAt
        && incoming().deducted == true
        && 'deductedBySalaryId' in incoming()
        && 'deductedAt' in incoming()
        && incoming().deductedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'deducted',
          'deductedBySalaryId',
          'deductedAt'
        ])
        && existsAfter(/databases/$(database)/documents/salary_payments/$(incoming().deductedBySalaryId))
        && getAfter(/databases/$(database)/documents/salary_payments/$(incoming().deductedBySalaryId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/salary_payments/$(incoming().deductedBySalaryId)).data.employeeId == existing().employeeId;

      allow delete: if false;
    }

    // Collection: /salary_payments/{salaryId} (Strictly Admin ONLY — Append-Only Immutable)
    match /salary_payments/{salaryId} {
      allow get: if isVerifiedUser()
        && isValidId(salaryId)
        && isAdmin();

      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(salaryId)
        && isValidSalaryPayment(incoming())
        && incoming().reference == salaryId
        && incoming().createdAt == request.time
        && isAdmin()
        && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
        && (
          (
            incoming().netSalary > 0
            && incoming().moneyOutId == salaryId
            && existsAfter(/databases/$(database)/documents/money_out/$(salaryId))
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.employeeId == incoming().employeeId
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.salaryPaymentId == salaryId
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.category == 'Salary'
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.reference == salaryId
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.amount == incoming().netSalary
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.paymentDate == incoming().paymentDate
            && getAfter(/databases/$(database)/documents/money_out/$(salaryId)).data.paymentMethod == incoming().paymentMethod
          ) || (
            incoming().netSalary == 0
            && incoming().moneyOutId == ''
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /cheques/{chequeId} (Admin & Accountant ONLY — Strict Atomic State Machine)
    match /cheques/{chequeId} {
      allow get: if isVerifiedUser()
        && isValidId(chequeId)
        && isAdminOrAccountant();

      allow list: if isAdminOrAccountant();

      allow create: if isVerifiedUser()
        && isValidId(chequeId)
        && isValidCheque(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().endorsedSupplierId == null
        && incoming().endorsedSupplierName == null
        && incoming().endorsedDate == null
        && incoming().clearedDate == null
        && incoming().bouncedDate == null
        && incoming().bounceReason == ''
        && incoming().moneyInId == null
        && incoming().clientLedgerEntryId == null
        && incoming().supplierLedgerEntryId == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdminOrAccountant()
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId));

      allow update: if isVerifiedUser()
        && isValidId(chequeId)
        && isValidCheque(incoming())
        && isAdminOrAccountant()
        && incoming().ownerId == existing().ownerId
        && incoming().clientId == existing().clientId
        && incoming().clientName == existing().clientName
        && incoming().amount == existing().amount
        && incoming().bankName == existing().bankName
        && incoming().chequeNo == existing().chequeNo
        && incoming().chequeDate == existing().chequeDate
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Self Clear (Deposit to Bank) — Atomically creates money_in (Bank) + client_ledger (credit)
          (
            existing().status == 'Pending'
            && incoming().status == 'Cleared (Self)'
            && incoming().clearedDate is string
            && incoming().moneyInId is string
            && incoming().clientLedgerEntryId == incoming().moneyInId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'clearedDate',
              'moneyInId',
              'clientLedgerEntryId',
              'note',
              'updatedAt'
            ])
            && existsAfter(/databases/$(database)/documents/money_in/$(incoming().moneyInId))
            && getAfter(/databases/$(database)/documents/money_in/$(incoming().moneyInId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/money_in/$(incoming().moneyInId)).data.clientId == existing().clientId
            && getAfter(/databases/$(database)/documents/money_in/$(incoming().moneyInId)).data.paymentMethod == 'Bank'
            && getAfter(/databases/$(database)/documents/money_in/$(incoming().moneyInId)).data.amount == existing().amount
            && getAfter(/databases/$(database)/documents/money_in/$(incoming().moneyInId)).data.paymentDate == incoming().clearedDate
            && existsAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId))
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.clientId == existing().clientId
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.txn_type == 'payment'
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.debit == 0
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.credit == existing().amount
          ) || (
            // Action 2: Endorse to Supplier — Records supplier endorsement without altering ledgers yet
            existing().status == 'Pending'
            && incoming().status == 'Endorsed to Supplier'
            && incoming().endorsedSupplierId is string
            && incoming().endorsedSupplierName is string
            && incoming().endorsedDate is string
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'endorsedSupplierId',
              'endorsedSupplierName',
              'endorsedDate',
              'note',
              'updatedAt'
            ])
            && exists(/databases/$(database)/documents/suppliers/$(incoming().endorsedSupplierId))
          ) || (
            // Action 3: Cleared by Supplier — Atomically reduces supplier payable (debit) & settles client due (credit)
            existing().status == 'Endorsed to Supplier'
            && existing().endorsedSupplierId is string
            && incoming().status == 'Cleared (Supplier)'
            && incoming().clearedDate is string
            && incoming().supplierLedgerEntryId is string
            && incoming().clientLedgerEntryId is string
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'clearedDate',
              'supplierLedgerEntryId',
              'clientLedgerEntryId',
              'note',
              'updatedAt'
            ])
            && existsAfter(/databases/$(database)/documents/supplier_ledger/$(incoming().supplierLedgerEntryId))
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(incoming().supplierLedgerEntryId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(incoming().supplierLedgerEntryId)).data.supplierId == existing().endorsedSupplierId
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(incoming().supplierLedgerEntryId)).data.txn_type == 'payment'
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(incoming().supplierLedgerEntryId)).data.debit == existing().amount
            && getAfter(/databases/$(database)/documents/supplier_ledger/$(incoming().supplierLedgerEntryId)).data.credit == 0
            && existsAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId))
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.clientId == existing().clientId
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.txn_type == 'payment'
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.debit == 0
            && getAfter(/databases/$(database)/documents/client_ledger/$(incoming().clientLedgerEntryId)).data.credit == existing().amount
          ) || (
            // Action 4: Mark as Bounced — Terminal failure state from Pending or Endorsed
            existing().status in ['Pending', 'Endorsed to Supplier']
            && incoming().status == 'Bounced'
            && incoming().bouncedDate is string
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'bouncedDate',
              'bounceReason',
              'note',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }
  }
}
