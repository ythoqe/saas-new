        "initializedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "firstAdminUid",
        "initializedAt"
      ]
    },
    "Cheque": {
      "title": "Cheque",
      "description": "A client cheque instrument tracked through Pending, Endorsed to Supplier, Cleared (Self), Cleared (Supplier), or Bounced with atomic ledger and bank settlement.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "number"
        },
        "bankName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "chequeNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "chequeDate": {
