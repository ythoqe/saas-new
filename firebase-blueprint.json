  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Stores mill client contact profiles owned by authenticated operators. Does not store a balance field."
    },
    "/client_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/ClientLedgerEntry" },
      "description": "Append-only ledger of debit and credit transactions per client used to dynamically calculate Current Due."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Mill dyeing and washing orders tracking grey fabric intake, processing stage, final delivered gaj, and atomic invoice billing."
    },
    "/money_in/{paymentId}": {
      "schema": { "$ref": "#/entities/MoneyInRecord" },
      "description": "Append-only cash, bank, and mobile banking payment receipt records paired atomically with client_ledger payment credits."
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Stores mill vendor/supplier profiles owned by authenticated operators. Does not store a payable balance field."
    },
    "/supplier_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/SupplierLedgerEntry" },
      "description": "Append-only payable ledger per supplier. Total Payable = (Sum of Credit) - (Sum of Debit)."
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Append-only inventory purchase records atomically paired with supplier_ledger credit entries."
    },
    "/money_out/{paymentId}": {
      "schema": { "$ref": "#/entities/MoneyOutRecord" },
      "description": "Append-only cash/bank outflows atomically paired with supplier_ledger debit entries (SPAY-*), factory expenses (EXP-*), or employee advances (ADV-*)."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Append-only daily factory operating expenses atomically paired with money_out cash/bank outflow documents."
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Tracks mill chemicals, jute, dyes, and spare parts with live currentStock and minimum stock alert thresholds."
    },
    "/stock_movements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Append-only stock movement audit log for opening balances, Stock In, Stock Out, and Purchase In additions."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Stores mill employee profiles, departments, joining dates, and basic monthly salaries."
    },
    "/employee_advances/{advanceId}": {
      "schema": { "$ref": "#/entities/EmployeeAdvance" },
      "description": "Append-only weekly advance log per employee atomically paired with money_out outflows (ADV-*)."
    }
  }
}
