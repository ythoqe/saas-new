{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "A dyeing and washing mill buyer or garment factory client. Financial dues are never stored on this document and are always calculated dynamically from client_ledger.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mobile": {
          "type": "string",
          "minLength": 5,
          "maxLength": 25,
          "pattern": "^[+0-9 ()-]+$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "clientName",
        "companyName",
        "mobile",
        "address",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClientLedgerEntry": {
      "title": "ClientLedgerEntry",
      "description": "An immutable append-only accounting ledger transaction for a client. Current Due = (Sum of Debit) - (Sum of Credit).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "txn_type": {
          "type": "string",
          "enum": ["opening", "invoice", "payment", "adjustment"]
        },
        "debit": {
          "type": "number"
        },
        "credit": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "reference": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "clientId",
        "txn_type",
        "debit",
        "credit",
        "note",
        "reference",
        "createdAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "A dyeing and washing mill production order linked to a client with atomic delivery billing.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "fabricType": {
          "type": "string",
          "enum": ["মার্কিন", "লংক্লথ", "ভয়েল", "পপলিন", "ইউনিটিকা", "আস্তর"]
        },
        "greyFabricThan": {
          "type": "number"
        },
        "greyFabricGaj": {
          "type": "number"
        },
        "rate": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Processing", "Dyeing", "Washing", "Finishing", "Delivered"]
        },
        "finalGaj": {
          "type": "number"
        },
        "finalBillAmount": {
          "type": "number"
        },
        "deliveredAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "clientId",
        "orderDate",
        "fabricType",
        "greyFabricThan",
        "greyFabricGaj",
        "rate",
        "status",
        "finalGaj",
        "finalBillAmount",
        "deliveredAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "MoneyInRecord": {
      "title": "MoneyInRecord",
      "description": "An immutable cash/bank/mobile-banking inflow record created atomically alongside a client_ledger payment credit entry (PAY-*) or as a cash reversal adjustment (REV-*).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "source": {
          "type": "string",
          "enum": ["client", "adjustment"]
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerEntryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reference": {
          "type": "string",
          "minLength": 5,
          "maxLength": 80,
          "pattern": "^(PAY|REV)-[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "paymentDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Cash", "Bank", "Mobile Banking"]
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "reference",
        "amount",
        "paymentDate",
        "paymentMethod",
        "note",
        "createdAt"
      ]
    },
    "Supplier": {
      "title": "Supplier",
