        "updatedAt"
      ]
    },
    "SupplierLedgerEntry": {
      "title": "SupplierLedgerEntry",
      "description": "An immutable append-only payable ledger log for a supplier. Credit increases payable (purchase/opening); Debit decreases payable (payment). Total Payable = (Sum of Credit) - (Sum of Debit).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "supplierId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "txn_type": {
          "type": "string",
          "enum": ["opening", "purchase", "payment", "adjustment"]
        },
        "debit": {
          "type": "number"
        },
        "credit": {
          "type": "number"
        },
        "reference": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "supplierId",
        "txn_type",
        "debit",
        "credit",
        "reference",
        "note",
        "createdAt"
      ]
    },
    "Purchase": {
