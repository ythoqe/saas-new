        "createdAt",
        "updatedAt"
      ]
    },
    "MoneyInRecord": {
      "title": "MoneyInRecord",
      "description": "An immutable cash/bank/mobile-banking inflow record created atomically alongside a client_ledger payment credit entry (PAY-*), an internal account transfer outflow (TRF-*), or a cash reversal adjustment (REV-*).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "source": {
          "type": "string",
          "enum": ["client", "adjustment", "transfer"]
        },
        "category": {
          "type": "string",
          "enum": ["Transfer"]
        },
        "transferId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "counterAccount": {
          "type": "string",
          "enum": ["Cash", "Bank", "Mobile Banking"]
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerEntryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reference": {
          "type": "string",
          "minLength": 5,
          "maxLength": 80,
          "pattern": "^(PAY|REV|TRF)-[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "paymentDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Cash", "Bank", "Mobile Banking"]
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "reference",
        "amount",
        "paymentDate",
        "paymentMethod",
        "note",
        "createdAt"
      ]
    },
