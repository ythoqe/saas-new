        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "clientId",
        "orderDate",
        "fabricType",
        "greyFabricThan",
        "greyFabricGaj",
        "rate",
        "status",
