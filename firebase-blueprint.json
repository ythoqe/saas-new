      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles and RBAC roles (admin, manager, accountant). Readable by self or admin; listable and role-updatable only by admin."
    },
    "/app_meta/{metaId}": {
      "schema": { "$ref": "#/entities/RbacBootstrap" },
      "description": "Stores singleton bootstrap sentinel (/app_meta/bootstrap) ensuring only the first user can self-bootstrap admin."
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Stores mill client contact profiles. Does not store a balance field. Edit/delete restricted to admin."
    },
    "/client_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/ClientLedgerEntry" },
      "description": "Append-only ledger of debit and credit transactions per client used to dynamically calculate Current Due."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Mill dyeing and washing orders accessible to admin and manager. Edit/delete restricted to admin while Processing."
    },
    "/money_in/{paymentId}": {
      "schema": { "$ref": "#/entities/MoneyInRecord" },
      "description": "Append-only cash, bank, and mobile banking payment receipts restricted to admin and accountant."
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Stores mill vendor/supplier profiles. Does not store a payable balance field. Edit/delete restricted to admin."
    },
    "/supplier_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/SupplierLedgerEntry" },
      "description": "Append-only payable ledger per supplier. Total Payable = (Sum of Credit) - (Sum of Debit)."
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Supplier purchase records accessible to admin and manager. Edit/delete restricted to admin while Pending."
    },
    "/money_out/{paymentId}": {
      "schema": { "$ref": "#/entities/MoneyOutRecord" },
      "description": "Append-only cash/bank outflows restricted to admin and accountant."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Append-only daily factory operating expenses restricted to admin and accountant."
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Mill chemicals, jute, dyes, and spare parts accessible to admin and manager. Master edit/delete restricted to admin."
    },
    "/stock_movements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Append-only stock movement audit log accessible to admin and manager."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Mill employee profiles restricted to admin."
    },
    "/employee_advances/{advanceId}": {
      "schema": { "$ref": "#/entities/EmployeeAdvance" },
      "description": "Weekly advance log per employee restricted to admin. Immutable except for a one-way atomic transition marking deducted=true when settled by a salary_payments document."
    },
    "/salary_payments/{salaryId}": {
      "schema": { "$ref": "#/entities/SalaryPayment" },
      "description": "Append-only monthly employee salary payment records restricted to admin, atomically linked to money_out (SAL-*) and deducted employee_advances."
    },
    "/cheques/{chequeId}": {
      "schema": { "$ref": "#/entities/Cheque" },
      "description": "Client cheque lifecycle log restricted to admin and accountant, enforcing atomic bank/ledger posting on Self Clear and Cleared by Supplier."
    }
  }
}
