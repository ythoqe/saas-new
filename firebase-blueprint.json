    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores authenticated user profiles and Role-Based Access Control (RBAC) assignments (admin, manager, accountant).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "manager", "accountant"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "RbacBootstrap": {
      "title": "RbacBootstrap",
      "description": "Singleton sentinel document locking the First User Admin assignment so only the very first registrant can atomically claim admin.",
      "type": "object",
      "properties": {
        "firstAdminUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
