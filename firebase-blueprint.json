{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "A dyeing and washing mill buyer or garment factory client. Financial dues are never stored on this document and are always calculated dynamically from client_ledger.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mobile": {
          "type": "string",
          "minLength": 5,
          "maxLength": 25,
          "pattern": "^[+0-9 ()-]+$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "clientName",
        "companyName",
        "mobile",
        "address",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClientLedgerEntry": {
      "title": "ClientLedgerEntry",
      "description": "An immutable append-only accounting ledger transaction for a client. Current Due = (Sum of Debit) - (Sum of Credit).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "txn_type": {
          "type": "string",
          "enum": ["opening", "invoice", "payment", "adjustment"]
        },
        "debit": {
          "type": "number"
        },
        "credit": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "reference": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "clientId",
        "txn_type",
        "debit",
        "credit",
        "note",
        "reference",
        "createdAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "A dyeing and washing mill production order linked to a client with atomic delivery billing.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
