        "source": {
          "type": "string",
          "enum": ["supplier", "expense", "advance", "adjustment"]
        },
        "supplierId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
